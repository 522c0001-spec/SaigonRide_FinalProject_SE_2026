@{
    ViewBag.Title = "System Reports";
}

<h2 style="color: #009A5A; font-weight: bold;">System Reports</h2>
<p class="text-muted">Analytics and insights</p>
<hr />

<!-- Dũng's Revenue Report -->
<div class="row">
    <div class="col-md-4">
        <div class="panel panel-default" style="border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05);">
            <div class="panel-body text-center">
                <h4 class="text-muted">Total Revenue</h4>
                <h2 style="color: #009A5A; font-weight: bold;">@ViewBag.TotalRevenue.ToString("N0") ₫</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-default" style="border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05);">
            <div class="panel-body text-center">
                <h4 class="text-muted">Total Rides</h4>
                <h2 style="color: #3b82f6; font-weight: bold;">@ViewBag.TotalRides</h2>
            </div>
        </div>
    </div>
</div>

<h4 style="margin-top: 30px;">Revenue by Vehicle Category</h4>
<table class="table table-bordered table-striped" style="background-color: white;">
    <tr style="background-color: #009A5A; color: white;">
        <th>Vehicle Category</th>
        <th>Revenue Generated</th>
    </tr>
    @foreach (var item in ViewBag.RevenueData)
    {
    <tr>
        <td>@item.Key</td>
        <td style="font-weight: bold;">@item.Value.ToString("N0") ₫</td>
    </tr>
    }
</table>

<!-- Tú's Station Inventory Report -->
<h4 style="margin-top: 40px;">Station Inventory Utilization</h4>
<div class="row">
    @foreach (var station in ViewBag.StationData)
    {
        double utilPercentage = station.MaxCapacity > 0 ? ((double)station.CurrentInventory / station.MaxCapacity) * 100 : 0;
        string barColor = utilPercentage < 20 ? "progress-bar-danger" : "progress-bar-success";

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-body">
                <strong>@station.LocationName</strong>
                <span class="pull-right text-muted">@station.CurrentInventory / @station.MaxCapacity Vehicles</span>
                <div class="progress" style="margin-top: 10px; margin-bottom: 0;">
                    <div class="progress-bar @barColor" role="progressbar" style="width: @utilPercentage%;">
                        @Math.Round(utilPercentage)% Full
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</div>