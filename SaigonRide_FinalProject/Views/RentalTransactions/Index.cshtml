@model IEnumerable<SaigonRide_FinalProject.Models.RentalTransaction>

@{
    ViewBag.Title = "Rental Transactions Index";
}

<div style="margin-bottom: 20px;">
    <h2 style="color: #009A5A; font-weight: bold;">System Rental Records</h2>

    @if (Session["UserType"] != null && Session["UserType"].ToString() == "Admin")
    {
    <p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success", style = "background-color: #009A5A; border: none;" })
    </p>
    }
</div>

<table class="table table-striped table-hover">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TransactionID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StartTime)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EndTime)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BaseFare)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AppliedDiscount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalPaid)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PaymentMethod)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Station.LocationName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Station1.LocationName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.User.FullName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Vehicle.Category)
        </th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TransactionID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.StartTime)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EndTime)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BaseFare)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AppliedDiscount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TotalPaid)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PaymentMethod)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Station.LocationName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Station1.LocationName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.User.FullName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Vehicle.Category)
        </td>
        <td>
            @if (Session["UserType"] != null && Session["UserType"].ToString() == "Admin")
            {
            @Html.ActionLink("Edit", "Edit", new { id = item.TransactionID }, new { @class = "btn btn-xs btn-default" })
            @Html.ActionLink("Details", "Details", new { id = item.TransactionID }, new { @class = "btn btn-xs btn-info" })
            @Html.ActionLink("Delete", "Delete", new { id = item.TransactionID }, new { @class = "btn btn-xs btn-danger" })
            }
            else
            {
            @Html.ActionLink("Details", "Details", new { id = item.TransactionID }, new { @class = "btn btn-xs btn-info" })
            }
        </td>
    </tr>
    }
</table>