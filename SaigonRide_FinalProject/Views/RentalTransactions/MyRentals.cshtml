@model IEnumerable<SaigonRide_FinalProject.Models.RentalTransaction>

@{ ViewBag.Title = "My Dashboard"; }

<div style="margin-bottom: 40px; margin-top: 20px;">
    <h2 style="color: #003366; font-weight: 800; font-size: 36px; letter-spacing: -1px;">My Dashboard</h2>
    <p style="color: #64748b; font-size: 18px;">Track your active rides and past trips.</p>
</div>

<div class="row glow-grid">
    @foreach (var item in Model)
    {
        bool isActive = item.EndTime == null;

    <div class="col-md-6" style="margin-bottom: 25px;">
        @if (isActive)
            {
        <div class="glow-card" style="background: rgba(0, 154, 90, 0.4);">
            <div class="glow-content" style="border: 2px solid #009A5A;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span style="font-weight: 800; font-size: 12px; color: #009A5A; letter-spacing: 1px;">● ACTIVE RIDE</span>
                    <span style="color: #94a3b8; font-size: 12px; font-weight: 600;">Started: @item.StartTime.ToString("hh:mm tt")</span>
                </div>

                <h3 style="font-weight: 800; color: #0f172a; margin-top: 0;">@(item.Vehicle?.Category ?? "Vehicle") (v-00@(item.VehicleID))</h3>
                <p style="color: #475569; font-weight: 500; margin-bottom: 20px;"><i class="glyphicon glyphicon-map-marker" style="color: #94a3b8;"></i> @(item.Station?.LocationName ?? "Unknown")</p>

                <div style="background-color: #ecfdf5; color: #065f46; border-radius: 12px; padding: 15px; margin-bottom: 20px; font-weight: 600; text-align: center;">
                    <i class="glyphicon glyphicon-refresh"></i> Ride is currently in progress...
                </div>

                @Html.ActionLink("End Ride & Checkout", "CheckoutForm", "RentalTransactions", new { id = item.TransactionID }, new { @class="btn btn-block", style="background-color: #ef4444; color: white; border-radius: 8px; padding: 14px; font-weight: 700; font-size: 16px;" })
            </div>
        </div>
            }
            else
            {
        <div class="glow-card" style="background: rgba(0,0,0,0.05);">
            <div class="glow-content" style="background: #f8fafc; border: 1px solid #e2e8f0; box-shadow: none;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span style="font-weight: 700; font-size: 12px; color: #64748b;">COMPLETED</span>
                    <span style="color: #94a3b8; font-size: 12px;">@item.StartTime.ToString("MMM dd, yyyy")</span>
                </div>

                <h4 style="font-weight: 700; color: #334155; margin-top: 0;">@(item.Vehicle?.Category ?? "Vehicle")</h4>
                <div style="color: #64748b; font-size: 13px; margin-bottom: 15px;">
                    <div><strong>From:</strong> @(item.Station?.LocationName ?? "-")</div>
                    <div><strong>To:</strong> @(item.Station1?.LocationName ?? "-")</div>
                </div>

                <div style="border-top: 1px dashed #cbd5e1; padding-top: 15px; text-align: right;">
                    <span style="font-size: 12px; color: #94a3b8; font-weight: 600; margin-right: 10px;">Total Paid</span>
                    <span style="color: #0f172a; font-weight: 800; font-size: 20px;">@(item.TotalPaid.HasValue ? item.TotalPaid.Value.ToString("N0") : "0") đ</span>
                </div>
            </div>
        </div>
            }
    </div>
    }
</div>