<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SaigonRide</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #0f172a;
            background-color: transparent !important;
        }

        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            background-color: #f8fafc;
            overflow: hidden;
        }

        .ambient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.65;
            animation: floatOrb 8s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 55vw;
            height: 55vw;
            background: #a7f3d0;
            top: -10%;
            left: -10%;
            animation-duration: 6s;
        }

        .orb-2 {
            width: 45vw;
            height: 45vw;
            background: #bae6fd;
            bottom: -15%;
            right: -10%;
            animation-delay: -2s;
            animation-duration: 8s;
        }

        .orb-3 {
            width: 35vw;
            height: 35vw;
            background: #d1fae5;
            top: 40%;
            left: 30%;
            animation-delay: -5s;
            animation-duration: 7s;
        }

        .navbar-inverse {
            background-color: rgba(255, 255, 255, 0.35) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(173, 230, 255, 0.6) !important;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        }

        .navbar-brand, .nav > li > a {
            color: #003366 !important;
            transition: color 0.3s ease;
        }

            .nav > li > a:hover {
                color: #009A5A !important;
            }

        .glow-grid {
            display: grid !important;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
            gap: 24px !important;
        }

            /* This stops Bootstrap's row classes from breaking the modern CSS Grid */
            .glow-grid::before, .glow-grid::after {
                display: none !important;
            }

            .glow-grid > div {
                width: 100% !important;
                padding: 0 !important;
            }

        .glow-card {
            position: relative;
            background: rgba(0, 154, 90, 0.1);
            border-radius: 16px;
            padding: 1px;
            transition: transform 0.2s ease;
            width: 100%;
            height: 100%; /* Ensures all cards in a row stretch to the same height */
        }

            .glow-card:hover {
                transform: translateY(-4px);
            }

            .glow-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                background: radial-gradient(600px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(0, 154, 90, 0.6), transparent 40%);
                z-index: 1;
                opacity: 0;
                transition: opacity 500ms;
                border-radius: inherit;
            }

            .glow-card:hover::before {
                opacity: 1;
            }

        .glow-content {
            position: relative;
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            height: 100%;
            border-radius: 15px;
            z-index: 2;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .navbar-collapse {
            display: block !important;
            height: auto !important;
            overflow: visible !important;
        }

        .navbar-nav {
            display: flex !important;
            flex-direction: row !important;
            margin: 0 !important;
            float: right !important;
        }

            .navbar-nav > li {
                float: none !important;
                display: inline-block !important;
            }

                .navbar-nav > li > a {
                    padding-left: 15px !important;
                    padding-right: 15px !important;
                    line-height: 50px !important;
                    padding-top: 0 !important;
                    padding-bottom: 0 !important;
                }

        .navbar-toggle {
            display: none !important;
        }
    </style>

    <style type="text/css">
        @Html.Raw("@keyframes floatOrb { 0% { transform: translate(0px, 0px) scale(1); } 100% { transform: translate(30vw, 25vh) scale(1.3); } }")
    </style>
</head>
<body>

    <div class="ambient-bg">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
        <div class="ambient-orb orb-3"></div>
    </div>

    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                @Html.ActionLink("SaigonRide", "Index", "Home", new { area = "" }, new { @class = "navbar-brand", style = "font-weight: 800; font-size: 24px; color: #009A5A !important;" })
            </div>
            <div class="navbar-collapse collapse pull-right">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Dashboard", "Index", "Home", null, new { style = "font-weight: 600;" })</li>

                    @if (Session["UserType"] != null && Session["UserType"].ToString() == "Admin")
                    {
                    <li>@Html.ActionLink("Stations", "Index", "Stations", null, new { style = "font-weight: 600;" })</li>
                    <li>@Html.ActionLink("Vehicles", "Index", "Vehicles", null, new { style = "font-weight: 600;" })</li>
                    <li>@Html.ActionLink("Reports", "Index", "Reports", null, new { style = "font-weight: 600;" })</li>
                    }

                    @if (Session["UserType"] != null && (Session["UserType"].ToString() == "Local" || Session["UserType"].ToString() == "Tourist"))
                    {
                    <li>@Html.ActionLink("My Rentals", "MyRentals", "RentalTransactions", null, new { style = "font-weight: 600;" })</li>
                    }

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="font-weight: 600;">
                            🌐 EN / VN <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="#">🇺🇸 English</a></li>
                            <li><a href="#">🇻🇳 Tiếng Việt</a></li>
                        </ul>
                    </li>

                    @if (Session["FullName"] != null)
                    {
                    <li><a href="#" style="font-weight: 700; color: #009A5A !important;"><i class="glyphicon glyphicon-user"></i> @Session["FullName"].ToString()</a></li>
                    <li>@Html.ActionLink("Logout", "Logout", "Account", null, new { style = "color: #ef4444 !important; font-weight: 600;" })</li>
                    }
                    else
                    {
                    <li>@Html.ActionLink("Login", "Login", "Account", null, new { style = "font-weight: 700; color: #009A5A !important;" })</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="container body-content" style="margin-top: 80px;">
        @RenderBody()
        <hr style="border-top: 1px solid rgba(0,0,0,0.1); margin-top: 50px;" />
        <footer style="color: #64748b; font-size: 14px; text-align: center; margin-bottom: 20px;">
            <p>&copy; @DateTime.Now.Year - SaigonRide Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        document.body.onmousemove = e => {
            for (const card of document.querySelectorAll('.glow-card')) {
                const rect = card.getBoundingClientRect(),
                    x = e.clientX - rect.left,
                    y = e.clientY - rect.top;
                card.style.setProperty("--mouse-x", `${x}px`);
                card.style.setProperty("--mouse-y", `${y}px`);
            }
        };
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>