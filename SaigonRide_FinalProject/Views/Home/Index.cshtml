@{
    ViewBag.Title = "Home Page";
}

<style>
    .hero-container {
        position: relative;
        height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 24px;
        margin-top: 20px;
        background: linear-gradient(rgba(0, 51, 102, 0.75), rgba(0, 154, 90, 0.65)), url('https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=1920&q=80') center/cover;
        background-attachment: fixed;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.15);
    }

    .hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
        color: white;
    }
</style>

<div class="hero-container">
    <div class="hero-content">
        <h1 style="font-size: 64px; font-weight: 800; margin-bottom: 20px; letter-spacing: -1px; text-shadow: 0 4px 15px rgba(0,0,0,0.3);">
            Move freely.<br /><span style="color: #6ee7b7;">Breathe easy.</span>
        </h1>
        <p style="font-size: 22px; color: #f8fafc; max-width: 650px; margin: 0 auto 40px auto; line-height: 1.6; text-shadow: 0 2px 10px rgba(0,0,0,0.3);">
            Unlock a premium electric scooter or bike instantly. Explore Ho Chi Minh City without the noise or the traffic.
        </p>

        @if (Session["UserType"] != null && (Session["UserType"].ToString() == "Local" || Session["UserType"].ToString() == "Tourist"))
        {
        <a href="/Stations" class="btn btn-lg" style="background-color: #009A5A; color: white; padding: 18px 45px; border-radius: 50px; font-weight: 800; font-size: 18px; box-shadow: 0 10px 25px rgba(0, 154, 90, 0.4); border: 2px solid #009A5A; transition: all 0.3s;">Find a Vehicle</a>
        }
        else if (Session["UserType"] == null)
        {
        <a href="/Account/Login" class="btn btn-lg" style="background-color: #ffffff; color: #003366; padding: 18px 45px; border-radius: 50px; font-weight: 800; font-size: 18px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); border: none; transition: all 0.3s;">Sign In to Ride</a>
        }
    </div>
</div>