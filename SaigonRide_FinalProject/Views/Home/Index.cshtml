@{
    ViewBag.Title = "Dashboard";
}

<!-- Hero Section -->
<div class="jumbotron" style="background-color: #e8f5e9; text-align: center; margin-top: 30px; border-radius: 15px;">
    <h1 style="color: #009A5A; font-weight: bold;">Welcome to SaigonRide</h1>
    <p class="lead" style="color: #555;">Ho Chi Minh City's Premier Vehicle Rental Network</p>
    <br />
    <a href="/Stations" class="btn btn-success btn-lg" style="background-color: #009A5A; border: none; padding: 15px 30px;">Find a Station</a>
</div>

<!-- Features Section (Mimicking the Figma Cards) -->
<h3 style="color: #009A5A; font-weight: bold; margin-bottom: 20px;">How It Works</h3>
<div class="row">
    <div class="col-md-4">
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); height: 150px;">
            <h4 style="color: #009A5A; font-weight: bold;">1. Find a Station</h4>
            <p>Locate the nearest SaigonRide station on our network to see available capacity.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); height: 150px;">
            <h4 style="color: #009A5A; font-weight: bold;">2. Choose Your Ride</h4>
            <p>Select from standard bikes, e-bikes, or e-scooters based on your trip needs.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); height: 150px;">
            <h4 style="color: #009A5A; font-weight: bold;">3. Ride & Return</h4>
            <p>Enjoy your ride! Get a 15% discount if you return it to a low-inventory station.</p>
        </div>
    </div>
</div>