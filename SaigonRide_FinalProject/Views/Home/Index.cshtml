@{
    ViewBag.Title = "Home Page";
}

<style>
    .hero-container {
        position: relative;
        height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 24px;
        margin-top: 20px;
        background: #ffffff;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.05);
    }

    .hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
    }
    /* Zen Morphing Shapes */
    .zen-shape {
        position: absolute;
        filter: blur(60px);
        opacity: 0.5;
        animation: morph 10s ease-in-out infinite both alternate;
        z-index: 1;
    }

    .shape-1 {
        background: #009A5A;
        width: 50vw;
        height: 50vw;
        left: -10%;
        top: -20%;
    }

    .shape-2 {
        background: #34d399;
        width: 40vw;
        height: 40vw;
        right: -5%;
        bottom: -10%;
        animation-delay: -3s;
    }

    .shape-3 {
        background: #60a5fa;
        width: 30vw;
        height: 30vw;
        left: 40%;
        top: 40%;
        animation-delay: -5s;
        opacity: 0.3;
    }

    @@keyframes morph {
        0% {
            border-radius: 40% 60% 70% 30% / 40% 40% 60% 50%;
            transform: rotate(0deg) scale(1);
        }

        100% {
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            transform: rotate(45deg) scale(1.1);
        }
    }
</style>

<div class="hero-container">
    <div class="zen-shape shape-1"></div>
    <div class="zen-shape shape-2"></div>
    <div class="zen-shape shape-3"></div>

    <div class="hero-content">
        <h1 style="font-size: 56px; font-weight: 800; color: #003366; margin-bottom: 20px; letter-spacing: -1px;">
            Move freely.<br /><span style="color: #009A5A;">Breathe easy.</span>
        </h1>
        <p style="font-size: 20px; color: #475569; max-width: 600px; margin: 0 auto 40px auto; line-height: 1.6;">
            Unlock a premium electric scooter or bike instantly. Explore Ho Chi Minh City without the noise.
        </p>

        @if (Session["UserType"] != null && (Session["UserType"].ToString() == "Local" || Session["UserType"].ToString() == "Tourist"))
        {
        <a href="/Stations" class="btn btn-lg" style="background-color: #009A5A; color: white; padding: 16px 40px; border-radius: 50px; font-weight: 700; font-size: 18px; box-shadow: 0 10px 20px rgba(0, 154, 90, 0.3); transition: transform 0.2s;">Find a Vehicle</a>
        }
        else if (Session["UserType"] == null)
        {
        <a href="/Account/Login" class="btn btn-lg" style="background-color: #003366; color: white; padding: 16px 40px; border-radius: 50px; font-weight: 700; font-size: 18px; box-shadow: 0 10px 20px rgba(0, 51, 102, 0.2); transition: transform 0.2s;">Sign In to Ride</a>
        }
    </div>
</div>