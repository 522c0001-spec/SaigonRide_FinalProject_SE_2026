@{
    Layout = null; // No navbar for the login screen
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Sign In to SaigonRide</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-card {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 450px;
        }

        .demo-box {
            background-color: #f0f4ff;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
            color: #2d559e;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h2 class="text-center" style="color: #004d30; font-weight: bold; margin-bottom: 25px;">Sign In to SaigonRide</h2>

        <form action="/Account/Login" method="post">
            <div class="form-group">
                <label style="color: #333; font-weight: 600;">Email</label>
                <input type="text" name="email" class="form-control" placeholder="Enter your email" required style="border-radius: 6px; padding: 20px 12px;" />
            </div>

            <div class="form-group">
                <label style="color: #333; font-weight: 600;">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter your password" value="password123" style="border-radius: 6px; padding: 20px 12px;" />
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
            <div class="alert alert-danger" style="background-color: #ffe6e6; color: #cc0000; border: 1px solid #ffcccc; border-radius: 8px;">
                @TempData["ErrorMessage"]
            </div>
            }

            <button type="submit" class="btn btn-success btn-block" style="background-color: #009A5A; border: none; padding: 12px; font-weight: bold; font-size: 16px; border-radius: 8px; margin-top: 20px;">Sign In</button>
        </form>

        <div class="demo-box">
            <p style="margin-bottom: 5px; font-weight: bold;">Demo Accounts:</p>
            <ul style="padding-left: 20px; margin-bottom: 0;">
                <li>Local: nguyen@example.com</li>
                <li>Tourist: john@example.com</li>
                <li>Admin: admin@saigonride.vn</li>
            </ul>
        </div>
    </div>
</body>
</html>