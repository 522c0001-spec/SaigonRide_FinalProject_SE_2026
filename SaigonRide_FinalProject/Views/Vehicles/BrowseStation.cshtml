@model IEnumerable<SaigonRide_FinalProject.Models.Vehicle>

@{ ViewBag.Title = "Select Vehicle"; }

<div style="margin-bottom: 30px; text-align: center; margin-top: 20px;">
    <h2 style="color: #003366; font-weight: 800; font-size: 36px; letter-spacing: -1px;">Select a Vehicle</h2>
    <p style="color: #64748b; font-size: 18px;"><i class="glyphicon glyphicon-map-marker"></i> @ViewBag.StationName</p>
</div>

<div style="max-width: 800px; margin: 0 auto;">
    <div class="row glow-grid">
        @if (!Model.Any())
        {
        <div class="col-md-12">
            <div class="alert" style="background-color: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 12px; padding: 20px; font-weight: 600; text-align: center;">
                No vehicles are currently available at this station.
            </div>
        </div>
        }
        else
        {
            foreach (var item in Model)
            {
                string price = item.Category == "Standard Bike" ? "500 đ/min" : item.Category == "Electric Scooter" ? "1.500 đ/min" : "1.000 đ/min";

        <div class="col-md-6" style="margin-bottom: 20px;">
            <div class="glow-card">
                <div class="glow-content" style="padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">@item.Category</span>
                            <h4 style="font-weight: 800; color: #0f172a; margin: 5px 0 8px 0;">v-00@(item.VehicleID)</h4>
                            <span style="color: #009A5A; font-weight: 700; font-size: 16px;">@price</span>
                        </div>

                        <div>
                            @Html.ActionLink("Select", "StartRental", "RentalTransactions", new { vehicleId = item.VehicleID }, new { @class="btn", style="background-color: #0f172a; color: white; border-radius: 50px; padding: 10px 24px; font-weight: 700; transition: transform 0.2s;" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
            }
        }
    </div>
</div>