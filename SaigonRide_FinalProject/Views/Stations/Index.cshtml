@model IEnumerable<SaigonRide_FinalProject.Models.Station>

@{ ViewBag.Title = "Station Network"; }

@if (Session["UserType"] != null && Session["UserType"].ToString() == "Admin")
{
<h2 style="color: #009A5A; font-weight: bold; margin-bottom: 20px;">Station Management</h2>
<p>@Html.ActionLink("Create New Station", "Create", null, new { @class = "btn btn-success", style = "background-color: #009A5A; border: none;" })</p>
<table class="table table-striped table-hover">
    <tr><th>Location Name</th><th>Max Capacity</th><th>Current Inventory</th><th>Actions</th></tr>
    @foreach (var item in Model) {
    <tr>
        <td>@Html.DisplayFor(m => item.LocationName)</td>
        <td>@Html.DisplayFor(m => item.MaxCapacity)</td>
        <td>@Html.DisplayFor(m => item.CurrentInventory)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.StationID }, new { @class = "btn btn-xs btn-default" })
            @Html.ActionLink("Details", "Details", new { id = item.StationID }, new { @class = "btn btn-xs btn-info" })
            @Html.ActionLink("Delete", "Delete", new { id = item.StationID }, new { @class = "btn btn-xs btn-danger" })
        </td>
    </tr>
    }
</table>
}
else
{
<div style="margin-bottom: 40px; text-align: center; margin-top: 20px;">
    <h2 style="color: #003366; font-weight: 800; font-size: 36px; letter-spacing: -1px;">Station Network</h2>
    <p style="color: #64748b; font-size: 18px;">Find available vehicles across Ho Chi Minh City</p>
</div>

<div class="row glow-grid">
    @foreach (var item in Model)
    {
// --- SMARTER IMAGE LOGIC (Anti-Portrait Edition) ---
        string searchTerms = "cityscape,architecture"; // Stronger default fallback
        string nameMatch = item.LocationName.ToLower();

        if (nameMatch.Contains("market") || nameMatch.Contains("chợ")) { searchTerms = "supermarket,streetmarket"; }
        else if (nameMatch.Contains("park") || nameMatch.Contains("công viên")) { searchTerms = "citypark,landscape"; }
        else if (nameMatch.Contains("university") || nameMatch.Contains("campus") || nameMatch.Contains("school")) { searchTerms = "university,college,building"; }
        else if (nameMatch.Contains("opera") || nameMatch.Contains("theater")) { searchTerms = "operahouse,opera"; }
        else if (nameMatch.Contains("suoi tien") || nameMatch.Contains("theme") || nameMatch.Contains("amusement")) { searchTerms = "themepark,landscape"; }
        else if (nameMatch.Contains("thao dien") || nameMatch.Contains("quan") || nameMatch.Contains("district")) { searchTerms = "cityscape,urban,metropolitan"; }
        else if (nameMatch.Contains("mall") || nameMatch.Contains("plaza")) { searchTerms = "shoppingmall,exterior"; }
        else { searchTerms = "cityscape,modern"; }
        // ---------------------------------------------------

        double utilPct = item.MaxCapacity > 0 ? ((double)item.CurrentInventory / item.MaxCapacity) * 100 : 0;
        string barColor = utilPct > 80 ? "#ef4444" : utilPct > 50 ? "#f59e0b" : "#009A5A";

    <div class="glow-card">
        <div class="glow-content" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">

            <div style="height: 160px; background: url('https://loremflickr.com/600/300/@searchTerms?lock=@item.StationID') center/cover;">
                <div style="height: 100%; width: 100%; background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.6));"></div>
            </div>

            <div style="padding: 24px; flex-grow: 1; display: flex; flex-direction: column;">
                <h3 style="margin-top: 0; font-weight: 800; color: #0f172a; font-size: 22px;">@item.LocationName</h3>
                <p style="color: #64748b; font-size: 14px; margin-bottom: 20px;"><i class="glyphicon glyphicon-map-marker"></i> Tap to view fleet</p>

                <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; margin-bottom: 8px; margin-top: auto;">
                    <span style="color: #475569;">Availability</span>
                    <span style="color: @barColor;">@item.CurrentInventory / @item.MaxCapacity</span>
                </div>
                <div style="background-color: #e2e8f0; border-radius: 10px; height: 8px; overflow: hidden; margin-bottom: 25px;">
                    <div style="background-color: @barColor; width: @utilPct%; height: 100%; border-radius: 10px; transition: width 0.5s ease;"></div>
                </div>

                <a href="/Vehicles/BrowseStation?stationId=@item.StationID" class="btn btn-block" style="background-color: #009A5A; color: white; font-weight: 700; border-radius: 8px; padding: 14px; transition: background 0.2s; box-shadow: 0 4px 10px rgba(0,154,90,0.2);">
                    <i class="glyphicon glyphicon-flash"></i> Rent Vehicle
                </a>
            </div>
        </div>
    </div>
    }
</div>
}